      "scenario": "scene_preserved_when_source_is_foreign",
      "expected": {
        "outcome": "preserved"
      }
    },
    {
      "scenario": "legacy_unknown_source_preserved",
      "expected": {
        "outcome": "preserved"
      }
    },
    {
      "scenario": "legacy_source_equals_backup_residue_only",
      "expected": {
        "outcome": "residueOnly"
      }
    },
    {
      "scenario": "voucher_mismatch_refuses_restore",
      "expected": {
        "outcome": "preserved"
      }
    },
    {
      "scenario": "manual_restore_with_confirmation_restores",
      "expected": {
        "outcome": "restoredByUser"
      }
    },
    {
      "scenario": "manual_restore_refuses_without_confirmation",
      "expected": {
        "outcome": "refused"
      }
